rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /bornes/{id} { allow read, create, update, delete: if request.auth != null; }
    match /batiments/{id} { allow read, create, update, delete: if request.auth != null; }
    match /batimen/{id} { allow read, create, update, delete: if request.auth != null; }
    match /prevention/{id} { allow read, create, update, delete: if request.auth != null; }
    match /vehicules/{id} { allow read, create, update, delete: if request.auth != null; }
    match /utilisations_vehicules/{id} { allow read, create, update, delete: if request.auth != null; }
    match /evenements_commandement/{id} { allow read, create, update, delete: if request.auth != null; }
    match /configuration/{id} { allow read, create, update, delete: if request.auth != null; }
    match /{document=**} { allow read, write: if false; }
  }
}
